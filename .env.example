# Telegram API credentials
# Получить на https://my.telegram.org/apps
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# ─── v2.0: авторизация админки ──────────────────────────────
# Секрет для подписи JWT (сгенерировать: openssl rand -hex 32)
JWT_SECRET=change_me_to_random_64_hex_chars
# Логин админа (по умолчанию "admin")
# ADMIN_USERNAME=admin
# Пароль админа. Если не задать — при первом запуске сгенерируется
# случайный и ОДИН РАЗ напечатается в логе контейнера.
# ADMIN_PASSWORD=your_strong_password

# ─── v2.0: названия RSS-потоков (можно менять в /admin) ─────
# RSS_NEWS_TITLE=Новости
# RSS_ANALYTICS_TITLE=Аналитика

# ─── Первый запуск / локалка ────────────────────────────────
# Каналы для первичного сида БД (потом список живёт в /admin).
# CHANNELS=markettwits
# Разметка потоков при сиде:
# NEWS_CHANNELS=markettwits
# ANALYTICS_CHANNELS=
# HISTORY=1          # Спарсить всю историю (первый запуск)
# LIMIT=1000         # Ограничить кол-во постов
